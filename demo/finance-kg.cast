[0.001, "o", "  \u001b[2mcypher>\u001b[0m \u001b[33mMATCH \u001b[0m\u001b[1;33m(\u001b[0m\u001b[33me:LegalEntity\u001b[0m\u001b[1;33m)\u001b[0m\u001b[33m-\u001b[0m\u001b[1;33m[\u001b[0m\u001b[33m:LOCATED_IN\u001b[0m\u001b[1;33m]\u001b[0m\u001b[33m->\u001b[0m\u001b[1;33m(\u001b[0m\u001b[33mhom\u001b[0m\u001b[1;33me:C\u001b[0m\u001b[33mountry\u001b[0m\u001b[1;33m)\u001b[0m\u001b[33m WHERE home.iso3 = \u001b[0m\u001b[33m\"IND\"\u001b[0m\u001b[33m MATCH \u001b[0m\r\n\u001b[1;33m(\u001b[0m\u001b[33me\u001b[0m\u001b[1;33m)\u001b[0m\u001b[33m-\u001b[0m\u001b[1;33m[\u001b[0m\u001b[1;33mc:C\u001b[0m\u001b[33mONSOLIDATED_BY\u001b[0m\u001b[1;33m]\u001b[0m\u001b[33m->\u001b[0m\u001b[1;33m(\u001b[0m\u001b[33mp:LegalEntity\u001b[0m\u001b[1;33m)\u001b[0m\u001b[33m WHERE c.level = \u001b[0m\u001b[33m\"ultimate\"\u001b[0m\u001b[33m MATCH \u001b[0m\r\n\u001b[1;33m(\u001b[0m\u001b[33mp\u001b[0m\u001b[1;33m)\u001b[0m\u001b[33m-\u001b[0m\u001b[1;33m[\u001b[0m\u001b[33m:LOCATED_IN\u001b[0m\u001b[1;33m]\u001b[0m\u001b[33m->\u001b[0m\u001b[1;33m(\u001b[0m\u001b[33mk:Country\u001b[0m\u001b[1;33m)\u001b[0m\u001b[33m WHERE k.iso3 \u001b[0m\u001b[1;33m<\u001b[0m\u001b[1;33m>\u001b[0m\u001b[33m \u001b[0m\u001b[33m\"IND\"\u001b[0m\u001b[33m WITH k.name AS parent_country, \u001b[0m\u001b[1;33mcount\u001b[0m\u001b[1;33m(\u001b[0m\u001b[33mDISTINCT \u001b[0m\r\n\u001b[33me\u001b[0m\u001b[1;33m)\u001b[0m\u001b[33m AS entities, \u001b[0m\u001b[1;33mcount\u001b[0m\u001b[1;33m(\u001b[0m\u001b[33mDISTINCT p\u001b[0m\u001b[1;33m)\u001b[0m\u001b[33m AS parents RETURN parent_country, entities, parents ORDER BY \u001b[0m\r\n\u001b[33mentities DESC, parent_country LIMIT \u001b[0m\u001b[1;33m"]
