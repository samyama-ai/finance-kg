[0.002, "o", "  \u001b[2mcypher>\u001b[0m \u001b[33mMATCH \u001b[0m\u001b[1;33m(\u001b[0m\u001b[1;33ma:Acc\u001b[0m\u001b[33mount\u001b[0m\u001b[1;33m)\u001b[0m\u001b[33m-\u001b[0m\u001b[1;33m[\u001b[0m\u001b[33mt1:TRANSFER\u001b[0m\u001b[1;33m]\u001b[0m\u001b[33m->\u001b[0m\u001b[1;33m(\u001b[0m\u001b[1;33mb:Acc\u001b[0m\u001b[33mount\u001b[0m\u001b[1;33m)\u001b[0m\u001b[33m-\u001b[0m\u001b[1;33m[\u001b[0m\u001b[33mt2:TRANSFER\u001b[0m\u001b[1;33m]\u001b[0m\u001b[33m->\u001b[0m\u001b[1;33m(\u001b[0m\u001b[1;33mc:Acc\u001b[0m\u001b[33mount\u001b[0m\u001b[1;33m)\u001b[0m\u001b[33m-\u001b[0m\u001b[1;33m[\u001b[0m\u001b[33mt3:TRANSFER\u001b[0m\u001b[1;33m]\u001b[0m\u001b[33m->\u001b[0m\u001b[1;33m(\u001b[0m\u001b[33ma\u001b[0m\u001b[1;33m)\u001b[0m\r\n\u001b[33mWHERE t1.amount_usd >= \u001b[0m\u001b[1;33m15000.0\u001b[0m\u001b[33m AND t2.amount_usd >= \u001b[0m\u001b[1;33m15000.0\u001b[0m\u001b[33m AND t3.amount_usd >= \u001b[0m\u001b[1;33m15000.0\u001b[0m\u001b[33m AND a.id < \u001b[0m\r\n\u001b[33mb.id AND a.id < c.id WITH a.account_no AS first, b.account_no AS second, c.account_no AS third, \u001b[0m\r\n\u001b[1;33mround\u001b[0m\u001b[1;33m(\u001b[0m\u001b[33mt1.amount_usd\u001b[0m\u001b[1;33m)\u001b[0m\u001b[33m AS sent_usd, \u001b[0m\u001b[1;33mround\u001b[0m\u001b[1;33m(\u001b[0m\u001b[33mt3.amount_usd\u001b[0m\u001b[1;33m)\u001b[0m\u001b[33m AS returned_usd RETURN first, second, third, \u001b[0m\r\n\u001b[33msent_usd, returned_usd ORDER BY sent_usd DESC, first LIMIT \u001b[0m\u001b[1;33m10\u001b[0m\r\n"]
